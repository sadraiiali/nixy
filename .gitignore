# Fontiran proprietary webfont binaries (licensed locally; do not push)
# Keep README.md + LICENSE.txt in git; restore .woff/.woff2 from your Eco zips.
static/fonts/peyda/*.woff
static/fonts/peyda/*.woff2
static/fonts/peyda/*.ttf
static/fonts/peyda/*.otf
static/fonts/iranyekan/*.woff
static/fonts/iranyekan/*.woff2
static/fonts/iranyekan/*.ttf
static/fonts/iranyekan/*.otf

# Build-time GitHub avatars (tiny WebP; regenerated by npm scripts)
# Keep README.md tracked; images are downloaded on build / npm run avatars|contributors
static/icons/sources/*.webp
static/icons/contributors/*.webp
