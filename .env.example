# =============================================================================
# Project config — copy to `.env` and fill in secrets.
# =============================================================================

# --- Public site (Cloudflare Pages / social previews) ---
# Absolute origin for Open Graph / Twitter image URLs (no trailing slash).
# Example: https://nix-notes.pages.dev
PUBLIC_SITE_URL=

# --- OpenAI-compatible API ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-3.5-flash-lite
OPENAI_TEMPERATURE=0.2
OPENAI_REQUEST_PAUSE_SEC=0.3
OPENAI_HTTP_REFERER=
OPENAI_APP_TITLE=nix-notes

# --- Single-page download (optional) ---
DOWNLOAD_URL=https://nixos.org/guides/how-nix-works/
DOWNLOAD_OUTPUT=how-nix-works.md
DOWNLOAD_USER_AGENT=nix-guide-dl/0.1
DOWNLOAD_TIMEOUT_SEC=60

# --- nix.dev tutorials from GitHub ---
NIX_DEV_OWNER=NixOS
NIX_DEV_REPO=nix.dev
NIX_DEV_REF=master
NIX_DEV_PATH=source/tutorials/first-steps
NIX_DEV_OUTPUT=docs/en/first-steps
NIX_DEV_WEB=https://nix.dev/tutorials/first-steps/
GITHUB_TOKEN=

# --- Nix reference manual (NixOS/nix) ---
NIX_MANUAL_OWNER=NixOS
NIX_MANUAL_REPO=nix
NIX_MANUAL_REF=master
NIX_MANUAL_PATH=doc/manual/source
NIX_MANUAL_OUTPUT=docs/en/nix-manual
NIX_MANUAL_WEB=https://nix.dev/manual/nix/stable
# Keep relative links for local FA routes (publish rewrites them).
# Set true to rewrite every link to absolute nix.dev URLs at download time.
NIX_MANUAL_ABSOLUTE_URLS=false
NIX_MANUAL_INCLUDE_RELEASE_NOTES=false
NIX_MANUAL_SUBSTITUTE=true

# --- Nixpkgs manual (NixOS/nixpkgs doc/) ---
NIXPKGS_MANUAL_OWNER=NixOS
NIXPKGS_MANUAL_REPO=nixpkgs
NIXPKGS_MANUAL_REF=master
NIXPKGS_MANUAL_PATH=doc
NIXPKGS_MANUAL_OUTPUT=docs/en/nixpkgs-manual
NIXPKGS_MANUAL_WEB=https://nixos.org/manual/nixpkgs/stable
NIXPKGS_MANUAL_INCLUDE_RELEASE_NOTES=false

# --- Glossary ---
GLOSSARY_PATH=glossary.json
GLOSSARY_SOURCE_DOCS=docs/en/first-steps/index.md,docs/en/first-steps/ad-hoc-shell-environments.md,docs/en/first-steps/declarative-shell.md,docs/en/first-steps/reproducible-scripts.md,docs/en/first-steps/towards-reproducibility-pinning-nixpkgs.md
GLOSSARY_SUGGEST_BATCH=40
GLOSSARY_SUGGEST_FORCE=false

# --- Full document translation (after glossary approval) ---
TRANSLATE_TARGET_LANG=fa
TRANSLATE_CHUNK_CHARS=3500
TRANSLATE_USE_GLOSSARY=true
TRANSLATE_MIN_APPROVED=1
TRANSLATE_REQUIRE_NO_PENDING=false
TRANSLATE_SKIP_GLOSSARY_GATE=false
TRANSLATE_OUT_DIR=docs/fa/first-steps
TRANSLATE_DOCS=
